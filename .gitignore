
# sssf runtime
adws/adw_data/sessions/
adws/adw_data/sssf.db*
.env
__pycache__/
*.pyc

# skill symlink to the sssf checkout, machine-local
.claude/skills/sssf

# prototype runtime: one worktree per run
.factory/worktrees/

# prototype tooling
prototype/.venv/
aifactory/.venv/
aifactory/web/node_modules/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# machine-local settings (port, trace DB path) and the trace DB; never committed
.factory/local.yaml
.factory/trace.db*

# prototype validation: local runs are noise, github results are kept for 1.10
prototype/validation/results/*/local-*/

# aifactory validation: local runs are noise, github results are kept
aifactory/validation/results/*/local-*/

# sqlite side files appear whenever a committed trace DB is opened
aifactory/validation/results/**/*.db-shm
aifactory/validation/results/**/*.db-wal

# aifactory runtime of HAIFA developing itself (.factory/ config is committed)
.factory/trace.db
.factory/trace.db-*
.factory/data/
.factory/local.yaml

# validation: commit only summary.json and scenario JSON; traces, logs and agent transcripts stay local
aifactory/validation/results/*/*/trace/
aifactory/validation/results/*/*/logs/
